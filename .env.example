# No actives la indexación mientras marcas, productos, imágenes o precios sean ilustrativos.
VITE_ALLOW_INDEXING=false

# Solo activar con marcas, productos, precios, fotos e inventario reales y revisados.
VITE_CATALOG_IS_REAL=false

# Dominio público definitivo, sin ruta. Es obligatorio cuando VITE_ALLOW_INDEXING=true.
VITE_SITE_URL=https://www.dominio-confirmado.pe

# Para la futura integración. No activar todavía; nunca usar claves secretas con VITE_.
# VITE_SUPABASE_URL=https://proyecto.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
