# No actives la indexación mientras marcas, productos, imágenes o precios sean ilustrativos.
VITE_ALLOW_INDEXING=false

# Solo activar con marcas, productos, precios, fotos e inventario reales y revisados.
VITE_CATALOG_IS_REAL=false

# Dominio público definitivo, sin ruta. Es obligatorio cuando VITE_ALLOW_INDEXING=true.
VITE_SITE_URL=https://www.dominio-confirmado.pe

# Supabase Auth. Copiar a .env.local con valores públicos; nunca usar claves secretas con VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Catálogo remoto; 'local' se reserva para desarrollo y pruebas aisladas.
# Un error de Supabase nunca carga productos de muestra como alternativa.
VITE_CATALOG_SOURCE=supabase

# El build normal se considera producción; staging usa npm run build:staging.
# VITE_APP_ENV=production
# Antes de configurar un entorno independiente: npm run production:check.
# No reutilizar el proyecto, el bucket ni la API de desarrollo como producción.

# Origen del Worker de medios y checkout de prueba para Vite local. No es una credencial.
# Vacío si frontend y API se sirven desde el mismo Worker.
VITE_MEDIA_API_BASE_URL=

# Recuperación mediante código de uso único guardado por el cliente, sin correos.
# Registro sin confirmación y cambio de correo con contraseña actual.

# Migración futura de imágenes/vídeos: origen público y prefijo, sin credenciales.
# No activar hasta copiar y verificar los mismos objetos locales en R2/CDN.
# VITE_MEDIA_BASE_URL=https://media.dominio-confirmado.pe

# Mapa opcional de direcciones. Sin claves por defecto; solo carga al abrirlo.
# Proveedor raster alternativo: URL HTTPS con {z}/{x}/{y}; revisar sus condiciones.
# VITE_ADDRESS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_ADDRESS_MAP_ATTRIBUTION=Crédito adicional del proveedor
