{
  "name": "aroma-infini",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "cloudflare:types": "wrangler types ./worker-configuration.d.ts",
    "cloudflare:dev": "npm run build && wrangler dev --env staging --local",
    "cloudflare:check": "npm run build && wrangler deploy --env staging --dry-run",
    "cloudflare:deploy": "npm run build && wrangler deploy --env staging"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "repomix": "^1.18.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "wrangler": "^4.147.0"
  }
}
