{
  "name": "aroma-infini",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "pretypecheck": "npm run cloudflare:types",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "production:check": "node scripts/check-production.mjs",
    "test:production": "node --test tests/production-readiness.test.mjs",
    "test:worker-build": "node --experimental-strip-types --test tests/worker-build.test.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "staging:check": "node --experimental-strip-types scripts/check-staging.mjs",
    "test:staging": "node --experimental-strip-types --test tests/staging-check.test.mjs",
    "test:seo:worker": "playwright test --config playwright.seo-worker.config.ts",
    "test:reviews": "playwright test --config playwright.reviews.config.ts",
    "test:complaints": "playwright test --config playwright.complaints.config.ts",
    "test:site-settings": "playwright test --config playwright.site-settings.config.ts",
    "backup:development": "node scripts/backup-development.mjs --confirm-development-export",
    "backup:production": "node scripts/backup-development.mjs --confirm-production-export",
    "backup:restore": "node scripts/restore-development-backup.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "test:backup": "node --test tests/backup-development.test.mjs tests/backup-verify.test.mjs tests/backup-restore.test.mjs",
    "prebuild": "npm run cloudflare:types && node scripts/generate-seo-files.mjs",
    "postbuild": "node scripts/prerender-seo.mjs && node --experimental-strip-types scripts/worker-build.mjs seal production",
    "test:e2e": "playwright test",
    "test:node": "node scripts/test-isolated.mjs node",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:auth:supabase": "playwright test --config playwright.supabase.config.ts",
    "test:catalog:supabase": "playwright test --config playwright.catalog.config.ts",
    "test:media:worker": "playwright test --config playwright.media-worker.config.ts",
    "test:media:browser": "playwright test --config playwright.media.config.ts",
    "test:home:supabase": "playwright test --config playwright.home.config.ts",
    "test:commerce:worker": "playwright test --config playwright.commerce-worker.config.ts",
    "test:push:crypto": "playwright test --config playwright.push-crypto.config.ts",
    "test:push:worker": "playwright test --config playwright.push-worker.config.ts",
    "test:push:browser": "playwright test --config playwright.admin-notifications.config.ts",
    "push:icons": "node scripts/generate-admin-pwa-icons.mjs",
    "push:configure": "node scripts/configure-admin-push.mjs",
    "test:commerce:settings": "playwright test --config playwright.commerce-settings.config.ts",
    "test:orders:supabase": "playwright test --config playwright.orders.config.ts",
    "test:checkout:supabase": "playwright test --config playwright.checkout.config.ts",
    "test:favorites:supabase": "playwright test --config playwright.favorites.config.ts",
    "test:interfaces:cleanup": "playwright test --config playwright.cleanup.config.ts",
    "test:sku": "playwright test --config playwright.sku.config.ts",
    "test:families": "playwright test --config playwright.families.config.ts",
    "test:supabase:sql": "node scripts/test-supabase-sql.mjs",
    "test:recovery:local": "node --test tests/local-postgres-recovery.test.mjs && node scripts/test-supabase-sql.mjs --restore-check",
    "test:supabase:public": "node scripts/verify-supabase-public.mjs",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "prebuild:staging": "npm run cloudflare:types && node scripts/generate-seo-files.mjs",
    "postbuild:staging": "node scripts/prerender-seo.mjs && node --experimental-strip-types scripts/worker-build.mjs seal staging",
    "preview": "vite preview --host 127.0.0.1",
    "cloudflare:types": "wrangler types ./worker-configuration.d.ts",
    "cloudflare:dev": "npm run build:staging && node --experimental-strip-types scripts/worker-build.mjs check staging && wrangler dev --env staging --local",
    "cloudflare:check": "npm run build:staging && node --experimental-strip-types scripts/worker-build.mjs check staging && wrangler deploy --env staging --dry-run",
    "cloudflare:check:production": "npm run build && node --experimental-strip-types scripts/worker-build.mjs check production && wrangler deploy --env production --dry-run",
    "cloudflare:deploy": "npm run build:staging && node --experimental-strip-types scripts/worker-build.mjs check staging && wrangler deploy --env staging"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@jsquash/webp": "1.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "^4.4.0",
    "mediabunny": "1.65.2",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.4",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
