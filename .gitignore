# Local credentials; sanitized examples remain versioned.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Dependencies, builds and generated types.
node_modules/
dist/
worker-configuration.d.ts
*.tsbuildinfo

# Local infrastructure state. Ignoring it does not authorize deleting it.
.wrangler/
supabase/.temp/
supabase/.branches/

# Test output, reports, benchmarks, protected backups and local evidence.
artifacts/
test-results/
playwright-report/
blob-report/
coverage/

# Tool caches and logs.
.vite/
.cache/
.npm/
*.log
# Root-level caches and npm's numbered crash logs are also generated.
/.eslintcache
/.prettiercache
/npm-debug.log*

# Local source exports; keep source files instead of generated dumps.
repomix-output.*
AROMAINFINI.xml
ECCOMERCE.xml

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini
