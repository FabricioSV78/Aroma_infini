{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aroma-infini-frontend",
  "main": "./worker/seo-router.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/tienda", "/marcas/*", "/producto/*"],
  },
  "env": {
    "staging": {
      "name": "aroma-infini-frontend-staging",
      "workers_dev": true,
      "preview_urls": true,
    },
  },
}
